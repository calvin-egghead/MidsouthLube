    "validate": "node scripts/validate_site.mjs",
    "check": "npm run lint && npm test && npm run build && npm run validate"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "vite": "^8.2.1"
  }
}
